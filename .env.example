# Copy to .env and fill in. .env is git-ignored.

# mapy.cz map tiles. Free key at https://developer.mapy.com (without it the map falls back to OpenStreetMap/CyclOSM).
MAPY_API_KEY=your-mapy-api-key

# Optional
# PORT=8765
# DEMO_SPEED=20           # demo ride playback speed, 0 = frozen snapshot for screenshots
# DEMO_GPX=demo/ride.gpx  # GPX replayed for tracking id "demo"
# CACHE_DAYS=3            # days a cached tracking response is kept
